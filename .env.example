# Copy to .env and fill in real values. NEVER commit .env.
# In Jenkins, the real file is stored as a "Secret file" credential with ID: cinelist-env

# Published port of the reverse proxy
HTTP_PORT=8080

# PostgreSQL
DB_NAME=cinelist
DB_USER=cinelist
DB_PASSWORD=change-me

# Express session signing secret (long random string).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# External APIs
OMDB_API_KEY=your-omdb-key-here
# Optional (better trailer lookup)
TMDB_API_KEY=
